[user]
	email = samuel.cristobal@protonmail.com
	name = Samuel Cristobal
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBeO9l6T5fPEu0iBsNg8UBhFowN9MO8n0BjrgBOBQECf

[commit]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	program = op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers


[init]
	defaultBranch = main

[push]
	default = current

[pull]
	rebase = true
	ff = only

[core]
	editor = nvim
	ignorecase = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
